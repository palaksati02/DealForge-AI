# DealForge AI - Environment Configuration Example
# Copy this file to .env and adjust variables as required

# Application
APP_NAME=DealForge AI
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Authentication & Security
JWT_SECRET=replace-with-a-secure-jwt-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MySQL 8.x Database Configuration
# Primary persistent relational database: dealforge_db
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=dealforge_db
DB_ECHO=False
# Optional: DATABASE_URL_OVERRIDE=sqlite:///./test.db

# LLM Providers (Optional for Demo Mode)
# Primary Provider: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Alternative Provider: Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# Demo Mode
# When True, agents and services operate in high-fidelity deterministic demonstration mode
# without requiring external paid LLM API keys.
DEMO_MODE=True

# Google ADK & A2A Services Configuration
ADK_SERVICE_HOST=127.0.0.1
ADK_SERVICE_PORT=8001
ADK_TIMEOUT_SECONDS=15
A2A_BASE_URL=http://127.0.0.1:8000/a2a

# MCP Server Configuration
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8002

# Procurement Engine Thresholds
AUTO_APPROVAL_THRESHOLD=1000000.00
OVERRUN_TOLERANCE_PERCENTAGE=0.0
DEFAULT_CURRENCY=INR

# Evaluation Scoring Weights (Must sum to 1.0)
WEIGHT_PRICE=0.35
WEIGHT_DELIVERY=0.20
WEIGHT_WARRANTY=0.15
WEIGHT_COMPLIANCE=0.15
WEIGHT_SPECIFICATION=0.15
